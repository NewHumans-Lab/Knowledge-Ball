{
  "name": "kg-events",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "node server/index.mjs",
    "start": "npm run build && node server/index.mjs",
    "build": "tsc && vite build",
    "test": "npm run test:domain && npm run test:protocol && npm run test:knowledge-edits && npm run test:demo && npm run test:edit-ui && npm run test:persistence && npm run test:gateway && npm run test:hosting && npm run test:scene && npm run test:core-sun && npm run test:mobile && npm run test:download && npm run test:server",
    "test:domain": "npx esbuild src/domain/KnowledgeModel.test.ts --bundle --platform=node --format=esm --outfile=.test-dist/knowledge-model.mjs && node .test-dist/knowledge-model.mjs && npx esbuild src/domain/KnowledgeMigration.test.ts --bundle --platform=node --format=esm --outfile=.test-dist/knowledge-migration.mjs && node .test-dist/knowledge-migration.mjs",
    "test:server": "node --test server/*.test.mjs",
    "test:persistence": "rm -rf .test-dist && tsc -p tsconfig.test.json --noEmit && npx esbuild src/persistence/PersistenceRegression.test.ts --bundle --platform=node --format=esm --outfile=.test-dist/persistence-regression.mjs && node .test-dist/persistence-regression.mjs",
    "test:gateway": "npx esbuild src/storage/GitHubKnowledgeGatewayRegression.test.ts --bundle --platform=node --format=esm --outfile=.test-dist/gateway-regression.mjs && node .test-dist/gateway-regression.mjs",
    "test:hosting": "npx esbuild src/storage/HostingEnvironmentRegression.test.ts --bundle --platform=node --format=esm --outfile=.test-dist/hosting-environment-regression.mjs && node .test-dist/hosting-environment-regression.mjs",
    "test:scene": "npx esbuild src/ui/scene/KnowledgeSceneRegression.test.ts --bundle --platform=node --format=esm --outfile=.test-dist/scene-regression.mjs && node .test-dist/scene-regression.mjs",
    "test:core-sun": "npx esbuild src/ui/scene/CoreSunVisualRegression.test.ts --bundle --platform=node --format=esm --outfile=.test-dist/core-sun-regression.mjs && node .test-dist/core-sun-regression.mjs",
    "test:mobile": "npx esbuild src/mobile/MobileShellRegression.test.ts --bundle --platform=node --format=esm --outfile=.test-dist/mobile-shell-regression.mjs && node .test-dist/mobile-shell-regression.mjs",
    "test:download": "node scripts/verify-android-download.mjs",
    "test:merge": "node scripts/verify-merge-clean.mjs",
    "test:pages": "node scripts/verify-pages.mjs",
    "android:build": "CAPACITOR_BUILD=true npm run build",
    "android:sync": "npm run android:build && cap sync android",
    "android:open": "npm run android:sync && cap open android",
    "ios:sync": "npm run android:build && cap sync ios",
    "ios:open": "npm run ios:sync && cap open ios",
    "preview": "vite preview",
    "test:protocol": "npx esbuild src/protocol/KnowledgeEditingProtocol.test.ts --bundle --platform=node --format=esm --outfile=.test-dist/knowledge-editing-protocol.mjs && node .test-dist/knowledge-editing-protocol.mjs",
    "test:knowledge-edits": "npx esbuild src/protocol/KnowledgeEditEventRegression.test.ts --bundle --platform=node --format=esm --outfile=.test-dist/knowledge-edit-event-regression.mjs && node .test-dist/knowledge-edit-event-regression.mjs",
    "test:edit-ui": "npx esbuild src/ui/KnowledgeEditUiRegression.test.ts --bundle --platform=node --format=esm --outfile=.test-dist/knowledge-edit-ui-regression.mjs && node .test-dist/knowledge-edit-ui-regression.mjs",
    "test:demo": "npx esbuild src/demo/seedDemoKnowledge.test.ts --bundle --platform=node --format=esm --outfile=.test-dist/demo-knowledge-regression.mjs && node .test-dist/demo-knowledge-regression.mjs"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.8",
    "@types/three": "^0.185.4",
    "typescript": "^5.5.4",
    "vite": "^5.4.2"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.8",
    "@capacitor/app": "^7.1.2",
    "@capacitor/browser": "^7.0.5",
    "@capacitor/core": "^7.6.8",
    "@capacitor/filesystem": "^7.1.8",
    "@capacitor/ios": "^7.6.8",
    "@capacitor/network": "^7.0.4",
    "@capacitor/share": "^7.0.4",
    "@capacitor/status-bar": "^7.0.6",
    "three": "^0.160.0"
  }
}
